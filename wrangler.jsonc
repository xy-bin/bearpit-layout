{
  // Cloudflare Workers 静态资源模式：/api/* 走 worker.js，其余直接返回静态文件
  "name": "bearpit-layout",
  "compatibility_date": "2026-01-01",
  "main": "worker.js",
  "kv_namespaces": [
    { "binding": "KV_DATA", "id": "0ceb0110e8bc4f2ab16590cdd3193643" }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
